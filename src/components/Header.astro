---
const navLinks = [
  { href: "/booths/360-video-booth", label: "360° Video Booth" },
  { href: "/booths/instant-print-booth", label: "Instant Print Booth" },
  { href: "/packages", label: "Packages" },
  { href: "/gallery", label: "Gallery" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-zinc-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / brand name -->
      <a href="/" class="flex items-center gap-2" aria-label="Eventsphere Photobooths — home">
        <img
          src="/img/logo.svg"
          alt="Eventsphere Photobooths logo"
          width="32"
          height="32"
          class="h-8 w-auto"
          onerror="this.style.display='none'"
        />
        <span class="font-bold text-lg text-zinc-900 leading-none">
          Eventsphere<span class="text-brand">.</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Main navigation" class="hidden md:flex items-center gap-1">
        {
          navLinks.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                "px-3 py-2 rounded-md text-sm font-medium transition-colors",
                currentPath === href
                  ? "text-brand font-semibold"
                  : "text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50",
              ]}
              aria-current={currentPath === href ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
        <a
          href="/contact"
          class="ml-3 inline-flex items-center px-4 py-2 rounded-full bg-brand hover:bg-brand-hover text-white text-sm font-semibold transition-colors"
        >
          Get a Quote
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
        class="md:hidden p-2 rounded-md text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 transition-colors"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="hidden md:hidden border-t border-zinc-100 bg-white"
  >
    <div class="px-4 py-3 space-y-1">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              "block px-3 py-2 rounded-md text-sm font-medium transition-colors",
              currentPath === href
                ? "text-brand bg-brand-tint font-semibold"
                : "text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50",
            ]}
            aria-current={currentPath === href ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="block mt-2 text-center px-4 py-2 rounded-full bg-brand hover:bg-brand-hover text-white text-sm font-semibold transition-colors"
      >
        Get a Quote
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
