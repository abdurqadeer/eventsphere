---
export interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: extraClass,
  target,
  rel,
} = Astro.props;

const base = "inline-flex items-center justify-center font-semibold rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";

const variants: Record<string, string> = {
  primary: "bg-brand hover:bg-brand-hover text-white focus-visible:outline-brand",
  secondary: "bg-brand-deep hover:bg-brand-deep/90 text-white",
  outline: "border-2 border-brand text-brand hover:bg-brand hover:text-white",
};

const sizes: Record<string, string> = {
  sm: "px-4 py-1.5 text-sm",
  md: "px-6 py-2.5 text-base",
  lg: "px-8 py-3.5 text-lg",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[base, variants[variant], sizes[size], extraClass]}
>
  <slot />
</a>
