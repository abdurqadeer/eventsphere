---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Inquiry Received | Eventsphere Photobooths"
  description="Thank you for reaching out. We'll confirm your date and get back to you within 24 hours."
  noindex={true}
>
  <Header slot="header" />
  <section class="min-h-[60vh] flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-md">
      <div class="w-16 h-16 bg-brand-tint rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-zinc-900 mb-3">We got your inquiry!</h1>
      <p class="text-zinc-600 mb-6">
        We'll check your date and follow up within 24 hours — usually sooner.
        In the meantime, check out our
        <a href="/gallery" class="text-brand hover:text-brand-hover underline">gallery</a>
        or the
        <a href="/faq" class="text-brand hover:text-brand-hover underline">FAQ</a>.
      </p>
      <a href="/" class="inline-flex items-center px-6 py-2.5 rounded-full bg-brand hover:bg-brand-hover text-white font-semibold transition-colors">
        Back to home
      </a>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>
